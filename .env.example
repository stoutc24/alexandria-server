# Server Configuration
PORT=3000

# Database
DB_PATH=./alexandria.db

# Security - CHANGE THESE IN PRODUCTION!
JWT_SECRET=your-super-secret-jwt-key-change-me

# Encryption key for stored server credentials (optional, defaults to JWT_SECRET)
# ENCRYPTION_KEY=your-encryption-key-for-credentials

# Password hashing cost (10-14 recommended, higher = more secure but slower)
BCRYPT_COST=12
