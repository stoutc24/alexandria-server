# Server Configuration
PORT=4000

# Database
DB_PATH=./alexandria.db

# Shared admin token — REQUIRED. The server refuses to start without it.
# Generate one with:  openssl rand -hex 32
# Send it as:  Authorization: Bearer <token>
# Family members do NOT use this. They link a device and get their own.
ALEXANDRIA_API_TOKEN=change-me

# Name shown when devices find this server on the network. Optional, but
# SET IT IN DOCKER: the default is the machine's hostname, which inside a
# container is the container id — so the server looks like a different
# machine after every recreate.
ALEXANDRIA_SERVER_NAME=Main PC

# The https address this server is reached at from outside, if you put
# it behind a reverse proxy. Optional. The server tells the app about it
# (so a phone linked over the LAN can switch to it), and it vouches for a
# phone that stays signed in when your proxy names no scheme; a proxy
# header saying http still wins. It must be a plain https:// address (no
# user name, query or fragment); anything else is ignored, with a warning
# in the log. Leave empty if unused.
ALEXANDRIA_PUBLIC_URL=

# The address your reverse proxy connects to this server from, if you use
# one: an IP address or a range (172.18.0.0/16), comma-separated for more.
# With it, the sign-in and linking limits count each visitor separately;
# without it, everyone behind the proxy shares one limit. Name only your
# proxy, and only one that sets or appends X-Forwarded-For itself. Not
# sure of the address? Leave it empty, open the admin page through the
# proxy once, and the log names it. Leave empty if unused.
ALEXANDRIA_TRUSTED_PROXIES=

# Alexandria accounts: the key that seals each person's service logins
# (their Plex, Audiobookshelf, … sign-ins), so the admin sets them up once
# and every device signs in by itself. Optional — without it people can
# still sign in and link devices, but no service logins are stored.
# Generate with:  openssl rand -base64 32
# Keep it OUT of backups of the database: that is what protects the logins.
# Lose it and the admin enters those logins again. See docs/ACCOUNTS.md.
# (Or put it in a file and set ALEXANDRIA_SECRETS_KEY_FILE instead.)
ALEXANDRIA_SECRETS_KEY=
