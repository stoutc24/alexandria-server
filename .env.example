# Server Configuration
PORT=4000

# Database
DB_PATH=./alexandria.db

# Shared admin token — REQUIRED. The server refuses to start without it.
# Generate one with:  openssl rand -hex 32
# Send it as:  Authorization: Bearer <token>
# Family members do NOT use this. They link a device and get their own.
ALEXANDRIA_API_TOKEN=change-me

# Name shown when devices find this server on the network. Optional, but
# SET IT IN DOCKER: the default is the machine's hostname, which inside a
# container is the container id — so the server looks like a different
# machine after every recreate.
ALEXANDRIA_SERVER_NAME=Main PC

# Trailers (optional). The Docker image ships all three tools; on a bare
# install put yt-dlp, ffmpeg and deno on PATH, or point at them here.
# A missing tool does not stop the server — trailers are just not offered.
# YT_DLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg
# DENO_PATH=/usr/local/bin/deno

# Where trailer MP4s are cached (default: a "trailers" directory beside
# the database) and how much disk they may use, in MB. The least recently
# played are evicted first.
# TRAILER_CACHE_DIR=./trailers
# TRAILER_CACHE_MB=4096
